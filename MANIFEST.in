include LICENSE
include README.md
include CHANGELOG.md
include CITATION.cff
include SECURITY.md

include pyproject.toml
include MANIFEST.in
include .gitignore
include .readthedocs.yaml

graft tests
prune docs

# Public documentation allowlist. Internal research, audits, development notes,
# and dated diagnostics must never enter a release artifact.
include docs/conf.py
include docs/requirements.txt
include docs/index.md
include docs/installation.md
include docs/quickstart.md
include docs/faq.md
include docs/algorithm.md
include docs/citation.md
include docs/changelog.md
include docs/license.md
include docs/references.md
recursive-include docs/_static *
recursive-include docs/api *.md
recursive-include docs/user_guide *.md
recursive-include docs/tutorials *.md *.ipynb

prune scripts
prune draft
prune archive
prune data
exclude DEVLOG.md
exclude AGENTS.md

graft .github/workflows

prune bak
prune .git
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune src/*.egg-info
global-exclude *.pyc
global-exclude __pycache__/*
global-exclude *.egg-info
global-exclude *.egg-info/*
global-exclude *.h5ad
global-exclude *.zip
global-exclude .DS_Store
global-exclude .ipynb_checkpoints
global-exclude *-checkpoint.*
global-exclude .ipynb_checkpoints/*
