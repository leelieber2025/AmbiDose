include LICENSE
include README.md
include CHANGELOG.md
include CITATION.cff
include SECURITY.md

include pyproject.toml
include MANIFEST.in
include .gitignore
include .readthedocs.yaml

graft tests
graft docs
prune docs/_build
exclude docs/development_benchmarks.md
exclude docs/resource_benchmark_4c24g.md

prune scripts
prune draft
prune archive
prune data
exclude DEVLOG.md
exclude AGENTS.md

graft .github/workflows

prune bak
prune .git
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune src/*.egg-info
global-exclude *.pyc
global-exclude __pycache__/*
global-exclude *.egg-info
global-exclude *.egg-info/*
global-exclude *.h5ad
global-exclude *.zip
global-exclude .DS_Store
global-exclude .ipynb_checkpoints
global-exclude *-checkpoint.*
global-exclude .ipynb_checkpoints/*
