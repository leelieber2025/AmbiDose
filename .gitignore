# Project specific
# Bundled large data is committed intentionally (gene features)
# but do not add user-generated .parquet outputs here by mistake
data/raw/
data/processed/
data/**/ckpt.tar.gz
data/**/*.tar.gz
data/**/posterior.h5
data/**/*.h5
data/**/*.h5ad
data/**/*.loom
data/**/*.zarr
/ckpt.tar.gz
/posterior.h5
# Keep source data/ but ignore generated outputs at root
gene_features.parquet
*_gene_features.parquet
*_features.parquet
# Temporary analysis outputs at the repo root only -- do not blanket-ignore
# .h5/.h5ad/.zip/.pdf/.png/.svg everywhere: that silently drops small test
# fixtures (e.g. @pytest.mark.slow data) and eval-report figures anywhere
# under the tree, with no warning that they never got tracked.
/*.pdf
/*.png
/*.svg
/*.zip
active_results/
# Local manuscripts, analysis dumps, and other non-package files
bak/
